---
import "../styles/global.css";
import { copy, languageMenuOptions, localizePath, type Lang } from "@/data/i18n";

type Props = {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  image?: string;
  lang?: Lang;
  noindex?: boolean;
};

const siteUrl = Astro.site ?? new URL("https://cssfinds.com");
const defaultCanonical = new URL(Astro.url.pathname, siteUrl).href;
const { title, description, canonical = defaultCanonical, schema, image = "/images/og/cssfinds-og.svg", lang = "en", noindex = false } = Astro.props;
const siteName = "CSSFinds";
const t = copy[lang];
const currentLanguage = languageMenuOptions.find((language) => language.code === lang) ?? languageMenuOptions[0];
const absoluteUrl = (path: string) => new URL(path, siteUrl).href;
const socialImage = absoluteUrl(image);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/cssbuy-spreadsheet-favicon.svg?v=16" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/cssbuy-spreadsheet-favicon-custom.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="cssbuy spreadsheet" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <button class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-4 focus:py-3 focus:font-bold" type="button" data-scroll-target="main">
      {t.skip}
    </button>
    <header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur">
      <nav class="shell flex min-h-16 flex-wrap items-center justify-between gap-3 py-3" aria-label="Primary navigation">
        <a href={localizePath("/", lang)} class="flex items-center gap-3 font-black tracking-normal">
          <img src="/cssbuy-spreadsheet-logo.png" alt="cssbuy spreadsheet" class="h-11 w-auto" width="242" height="60" />
          <span>CSSFinds</span>
        </a>
        <div class="flex flex-wrap items-center justify-end gap-2 text-sm font-bold">
          <div class="hidden items-center gap-2 md:flex">
            <a class="rounded-md px-3 py-2 text-ink/70 hover:bg-paper hover:text-ink" href={localizePath("/", lang)}>{t.nav.home}</a>
            <a class="rounded-md px-3 py-2 text-ink/70 hover:bg-paper hover:text-ink" href={localizePath("/", lang)}>Catalog</a>
            <a class="rounded-md px-3 py-2 text-ink/70 hover:bg-paper hover:text-ink" href="/how-to-buy/">How to Buy</a>
            <a class="rounded-md px-3 py-2 text-ink/70 hover:bg-paper hover:text-ink" href="/qc/">QC</a>
            <a class="rounded-md px-3 py-2 text-ink/70 hover:bg-paper hover:text-ink" href="/editorial-methodology/">Methodology</a>
            <a class="rounded-md px-3 py-2 text-ink/70 hover:bg-paper hover:text-ink" href="/about/">About</a>
          </div>
          <div class="relative" data-language-menu>
            <button
              class="control flex min-w-36 items-center justify-between gap-3 py-2 text-sm font-bold"
              type="button"
              aria-label={t.nav.language}
              aria-haspopup="true"
              aria-expanded="false"
              data-language-toggle
            >
              <span>{t.nav.language}</span>
              <span class="text-xs leading-none text-clay" aria-hidden="true" data-language-caret>▾</span>
            </button>
            <div
              class="absolute right-0 top-[calc(100%+8px)] z-50 hidden max-h-[72vh] w-[min(520px,calc(100vw-32px))] overflow-y-auto rounded-lg border border-line bg-white p-2 text-sm font-bold text-ink shadow-xl"
              role="menu"
              aria-label={t.nav.language}
              data-language-options
            >
              <div class="grid gap-1 sm:grid-cols-2">
              {
                languageMenuOptions.map((language) => {
                  const isCurrent = language.code === currentLanguage.code;
                  return (
                  <button
                    class={isCurrent ? "block w-full bg-[#f3ffd8] px-4 py-3 text-left text-ink" : "block w-full px-4 py-3 text-left text-ink/75 hover:bg-paper hover:text-ink"}
                    type="button"
                    role="menuitem"
                    lang={language.code}
                    data-translate-language={language.translateCode}
                  >
                    {language.label}
                  </button>
                  );
                })
              }
              </div>
            </div>
          </div>
        </div>
      </nav>
    </header>
    <div id="google_translate_element" class="sr-only" aria-hidden="true"></div>
    <main id="main">
      <slot />
    </main>
    <footer class="mt-16 border-t border-line bg-white py-10 text-ink">
      <div class="shell grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <p class="font-black">CSSFinds</p>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-ink/65">
            {t.footer}
          </p>
        </div>
        <div class="flex flex-wrap gap-2 text-sm font-bold text-ink/70">
          <a class="rounded-md px-3 py-2 hover:bg-paper hover:text-ink" href={localizePath("/", lang)}>Catalog</a>
          <a class="rounded-md px-3 py-2 hover:bg-paper hover:text-ink" href="/how-to-buy/">How to Buy</a>
          <a class="rounded-md px-3 py-2 hover:bg-paper hover:text-ink" href="/qc/">QC</a>
          <a class="rounded-md px-3 py-2 hover:bg-paper hover:text-ink" href="/about/">About</a>
          <a class="rounded-md px-3 py-2 hover:bg-paper hover:text-ink" href="/editorial-methodology/">Methodology</a>
          <a class="rounded-md px-3 py-2 hover:bg-paper hover:text-ink" href="/affiliate-disclosure/">Affiliate Disclosure</a>
          <a class="rounded-md px-3 py-2 hover:bg-paper hover:text-ink" href="/robots.txt">{t.footerRobots}</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<script is:inline>
  window.googleTranslateElementInit = function () {
    new window.google.translate.TranslateElement(
      {
        pageLanguage: "en",
        autoDisplay: false,
        includedLanguages: "en,de,es,fr,it,pl,pt,ro,sv,nl,da,fi,el,cs,hu,bg,sk,hr,sl,lt,lv,et,ga,mt,zh-CN,ja,ko",
      },
      "google_translate_element",
    );
  };
</script>

<script is:inline async defer src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

<script>
  const translationStorageKey = "cssfinds-translation-language";

  const applyTranslation = (language: string, attempt = 0) => {
    const select = document.querySelector(".goog-te-combo");

    if (select instanceof HTMLSelectElement) {
      if (select.value !== language) {
        select.value = language;
        select.dispatchEvent(new Event("change"));
      }
      return;
    }

    if (attempt < 100) {
      window.setTimeout(() => applyTranslation(language, attempt + 1), 200);
    }
  };

  const rememberTranslation = (language: string) => {
    try {
      window.localStorage.setItem(translationStorageKey, language);
    } catch {
      // Translation still works for the current page when storage is unavailable.
    }
  };

  const restoreTranslation = () => {
    try {
      const language = window.localStorage.getItem(translationStorageKey);
      if (language) {
        applyTranslation(language);
      }
    } catch {
      // Ignore storage restrictions and leave the page in its source language.
    }
  };

  document.querySelectorAll("[data-scroll-target]").forEach((control) => {
    control.addEventListener("click", () => {
      const targetId = control.getAttribute("data-scroll-target");
      const target = targetId ? document.getElementById(targetId) : null;

      if (target) {
        target.setAttribute("tabindex", "-1");
        target.scrollIntoView({ behavior: "smooth", block: "start" });
        target.focus({ preventScroll: true });
      }
    });
  });

  document.querySelectorAll("[data-language-menu]").forEach((menu) => {
    const button = menu.querySelector("[data-language-toggle]");
    const options = menu.querySelector("[data-language-options]");
    const caret = menu.querySelector("[data-language-caret]");

    if (!(button instanceof HTMLButtonElement) || !(options instanceof HTMLElement) || !(caret instanceof HTMLElement)) {
      return;
    }

    const closeMenu = () => {
      options.classList.add("hidden");
      button.setAttribute("aria-expanded", "false");
      caret.textContent = "▾";
    };

    const openMenu = () => {
      options.classList.remove("hidden");
      button.setAttribute("aria-expanded", "true");
      caret.textContent = "▴";
    };

    button.addEventListener("click", (event) => {
      event.stopPropagation();
      const isOpen = button.getAttribute("aria-expanded") === "true";
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    options.addEventListener("click", (event) => {
      event.stopPropagation();
    });

    options.querySelectorAll("[data-translate-language]").forEach((item) => {
      item.addEventListener("click", () => {
        const language = item.getAttribute("data-translate-language");

        if (language) {
          rememberTranslation(language);
          applyTranslation(language);
        }

        closeMenu();
      });
    });

    document.addEventListener("click", (event) => {
      if (!menu.contains(event.target as Node)) {
        closeMenu();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMenu();
        button.focus();
      }
    });
  });

  restoreTranslation();
</script>
