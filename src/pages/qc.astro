---
import { getBreadcrumbSchema } from "@/data/products";
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Buyer QC Photo Review Guide | CSSFinds";
const description =
  "Learn how CSSFinds checks direct StreetStyle buyer QC-photo evidence, what those photos can show, and what they cannot prove.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: "https://cssfinds.com/qc/",
  },
  getBreadcrumbSchema([
    { name: "CSSFinds", url: "https://cssfinds.com/" },
    { name: "Buyer QC Photo Guide", url: "https://cssfinds.com/qc/" },
  ]),
];
---

<BaseLayout title={title} description={description} canonical="https://cssfinds.com/qc/" schema={schema} lang="en">
  <section class="border-b border-line bg-white">
    <div class="shell py-10 md:py-14">
      <p class="text-sm font-black uppercase text-ocean">QC transparency</p>
      <h1 class="mt-3 max-w-4xl text-4xl font-black leading-tight tracking-normal text-ink md:text-5xl">
        Verify warehouse QC at the source
      </h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-ink/70">
        Every product in the current 42-item catalog links directly to the StreetStyle page where we confirmed a visible QC Reviews section. Those buyer photo sets are useful visual evidence, but CSSFinds does not host them and does not treat them as authentication.
      </p>
    </div>
  </section>

  <section class="shell mt-8 grid gap-5 md:grid-cols-3" aria-labelledby="qc-checklist-heading">
    <h2 id="qc-checklist-heading" class="sr-only">QC photo review checklist</h2>
    <article class="rounded-lg border border-line bg-white p-6 shadow-sm">
      <p class="text-sm font-black uppercase text-clay">Step 1</p>
      <h3 class="mt-2 text-xl font-black text-ink">Confirm the source</h3>
      <p class="mt-3 text-sm font-bold leading-6 text-ink/65">Use a product-specific album or warehouse order record. Do not rely on a generic gallery or an unrelated listing image.</p>
    </article>
    <article class="rounded-lg border border-line bg-white p-6 shadow-sm">
      <p class="text-sm font-black uppercase text-clay">Step 2</p>
      <h3 class="mt-2 text-xl font-black text-ink">Match the exact item</h3>
      <p class="mt-3 text-sm font-bold leading-6 text-ink/65">Verify seller, model, color, size, and batch so the photos correspond to the item you intend to purchase.</p>
    </article>
    <article class="rounded-lg border border-line bg-white p-6 shadow-sm">
      <p class="text-sm font-black uppercase text-clay">Step 3</p>
      <h3 class="mt-2 text-xl font-black text-ink">Inspect before shipment</h3>
      <p class="mt-3 text-sm font-bold leading-6 text-ink/65">Request warehouse photos and check measurements, materials, stitching, shape, labels, and visible defects before approving shipment.</p>
    </article>
  </section>

  <section class="shell mt-8">
    <div class="rounded-lg border border-line bg-paper p-6 md:flex md:items-center md:justify-between md:gap-6">
      <div>
        <h2 class="text-2xl font-black text-ink">Catalog QC status</h2>
        <p class="mt-2 max-w-2xl text-sm font-bold leading-6 text-ink/65">Every current catalog entry shows the number of visible buyer QC-photo sets recorded at review time and provides a direct evidence link. Recheck the source because pages and photo counts can change.</p>
      </div>
      <a class="button mt-5 min-h-12 shrink-0 border border-ink bg-ink text-white md:mt-0" href="/">Browse product catalog</a>
    </div>
  </section>
</BaseLayout>
