---
import { getBreadcrumbSchema } from "@/data/products";
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "How to Buy with CSSBuy | Research, QC and Shipping Guide";
const description =
  "A cautious step-by-step guide to researching a listing, submitting a product URL to CSSBuy, checking warehouse QC photos, and reviewing shipping costs before dispatch.";

const cssbuySignupUrl = "https://cssb.uy/1UOp";

const steps = [
  {
    number: "Step 1",
    title: "Research the Listing",
    eyebrow: "Start with evidence",
    body:
      "Start with the source page, recorded price, buyer QC sets, category checklist, measurements, and remaining risks. A listing in CSSFinds is a research lead, not a recommendation or guarantee that the item, seller, or batch will remain unchanged.",
    actionLabel: "Browse Checked Listings",
    actionUrl: "/",
    accent: "bg-ink text-white",
  },
  {
    number: "Step 2",
    title: "Submit the Product URL",
    eyebrow: "Confirm the exact option",
    body:
      "Copy the original product URL and submit it through CSSBuy. Confirm colour, size, quantity, seller notes, domestic delivery, service charges, and the current item price before paying; the CSSFinds snapshot may no longer match the source.",
    actionLabel: "Open CSSBuy (Sponsored)",
    actionUrl: cssbuySignupUrl,
    accent: "bg-[#ff4b0b] text-white",
  },
  {
    number: "Step 3",
    title: "Wait for Warehouse Receipt",
    eyebrow: "Do not approve unseen goods",
    body:
      "After the agent purchases the item, wait for warehouse receipt and uploaded photos. Match the order option and size label to what you submitted, and request missing measurements or angles while a return or exchange may still be possible under the service's current terms.",
    actionLabel: "Review the QC Checklist",
    actionUrl: "/qc/",
    accent: "bg-white text-ink border border-ink",
  },
  {
    number: "Step 4",
    title: "Review the Parcel Before Shipping",
    eyebrow: "Calculate the full landed cost",
    body:
      "Approve warehouse QC only after checking measurements and visible defects. Before dispatch, compare available shipping lines, chargeable weight, packaging, insurance, restrictions, tax or import exposure, and the destination's current rules. CSSFinds cannot predict delivery time or customs outcomes.",
    actionLabel: "Read Cost and Risk Notes",
    actionUrl: "/how-to-buy/",
    scrollTarget: "costs-and-risks",
    accent: "bg-white text-ink border border-line",
  },
];

const faqs = [
  {
    question: "How expensive is CSSBuy shipping?",
    answer:
      "There is no reliable universal amount. Shipping depends on chargeable weight, volume, destination, packaging, service options, and the lines available at checkout. Use the current estimate inside CSSBuy and keep a margin for changes, tax, and import charges.",
  },
  {
    question: "How long does CSSBuy delivery take?",
    answer:
      "CSSFinds does not publish a delivery-time promise. Seller dispatch, warehouse processing, route availability, carrier movement, customs, and local delivery can all change the timeline. Use the current estimate and tracking provided by the service and carrier.",
  },
  {
    question: "Do I need to check QC photos before shipping?",
    answer:
      "Yes. QC photos are your chance to inspect color, shape, size labels, stitching, logos, packaging, and obvious flaws before the parcel leaves the warehouse. Request extra photos if anything important is unclear.",
  },
  {
    question: "Can I use a CSSBuy spreadsheet if I am a beginner?",
    answer:
      "Yes, but treat it as a shortlist. Open one source at a time, compare measurements and QC evidence, note the verification date, and confirm all current details inside CSSBuy before paying.",
  },
  {
    question: "Why should I register before browsing products?",
    answer:
      "You do not need to register to read CSSFinds. An account is only needed when you decide to use CSSBuy's services. The external invite link is sponsored; confirm any current promotion and eligibility on CSSBuy because CSSFinds does not guarantee either.",
  },
];

const schema = getBreadcrumbSchema([
  { name: "CSSFinds", url: "https://cssfinds.com/" },
  { name: "How to Buy with CSSBuy", url: "https://cssfinds.com/how-to-buy/" },
]);
---

<BaseLayout title={title} description={description} canonical="https://cssfinds.com/how-to-buy/" schema={schema} lang="en">
  <section class="border-b border-line bg-white">
    <div class="shell grid gap-8 py-8 md:py-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div>
        <p class="text-sm font-black uppercase text-ocean">Beginner CSSBuy guide</p>
        <h1 class="mt-3 max-w-4xl text-3xl font-black leading-tight tracking-normal text-ink md:text-5xl">
          How to Buy with CSSBuy: Research, QC, and Shipping
        </h1>
        <p class="mt-4 max-w-3xl text-base leading-7 text-ink/70 md:text-lg">
          A cautious workflow for moving from a product lead to an agent order: verify the source, submit the exact option, inspect warehouse QC, and review the full shipping cost before dispatch.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a class="button min-h-14 bg-[#ff4b0b] px-6 text-base font-black text-white shadow-[0_14px_30px_rgba(255,75,11,0.3)] hover:bg-[#e83f00]" href={cssbuySignupUrl} target="_blank" rel="sponsored noopener">
            Open CSSBuy Invite (Sponsored)
          </a>
          <a class="button min-h-14 border border-ink bg-white px-6 text-base font-black text-ink" href="/">
            Browse Spreadsheet
          </a>
        </div>
        <p class="mt-3 text-sm font-bold text-ink/55">
          CSSFinds does not guarantee promotions, delivery times, customs outcomes, returns, or the condition of the item delivered.
        </p>
      </div>

      <div class="rounded-lg border border-line bg-paper p-3">
        <div class="rounded-md bg-white p-5 shadow-soft">
          <div class="grid gap-3">
            {steps.map((step, index) => (
              <button class="group grid grid-cols-[52px_1fr] gap-3 rounded-md border border-line bg-white p-3 text-left transition hover:border-ink hover:bg-[#fff7ed]" type="button" data-scroll-target={`step-${index + 1}`}>
                <span class="flex h-12 w-12 items-center justify-center rounded-md bg-ink text-sm font-black text-white">{index + 1}</span>
                <span>
                  <span class="block text-xs font-black uppercase text-clay">{step.number}</span>
                  <span class="mt-1 block text-base font-black text-ink group-hover:text-[#9a3412]">{step.title}</span>
                </span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="shell mt-8" aria-labelledby="steps-heading">
    <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="text-sm font-black uppercase text-clay">Step-by-step</p>
        <h2 id="steps-heading" class="mt-2 text-2xl font-black tracking-normal text-ink md:text-4xl">
          From First Click to Shipped Parcel
        </h2>
      </div>
      <p class="max-w-xl text-sm font-bold leading-6 text-ink/58">
        Pause at every handoff and verify the current source, order option, warehouse evidence, and total cost before continuing.
      </p>
    </div>

    <div class="grid gap-5">
      {steps.map((step, index) => (
        <article id={`step-${index + 1}`} class="scroll-mt-28 rounded-lg border border-line bg-white p-5 shadow-soft md:p-6">
          <div class="grid gap-5 lg:grid-cols-[180px_1fr_220px] lg:items-center">
            <div>
              <p class="text-sm font-black uppercase text-ocean">{step.eyebrow}</p>
              <div class="mt-3 flex items-center gap-3">
                <span class="flex h-14 w-14 items-center justify-center rounded-md bg-ink text-xl font-black text-white">{index + 1}</span>
                <p class="text-sm font-black uppercase text-ink/55">{step.number}</p>
              </div>
            </div>
            <div>
              <h3 class="text-2xl font-black tracking-normal text-ink">{step.title}</h3>
              <p class="mt-3 text-base leading-7 text-ink/70">{step.body}</p>
            </div>
            <div>
              {step.scrollTarget ? (
                <button class={`button w-full text-center ${step.accent}`} type="button" data-scroll-target={step.scrollTarget}>
                  {step.actionLabel}
                </button>
              ) : (
                <a class={`button w-full text-center ${step.accent}`} href={step.actionUrl} target={step.actionUrl.startsWith("http") ? "_blank" : undefined} rel={step.actionUrl.startsWith("http") ? "sponsored noopener" : undefined}>
                  {step.actionLabel}
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="costs-and-risks" class="shell mt-10 scroll-mt-24">
    <div class="grid gap-5 rounded-lg border border-line bg-ink p-5 text-white md:grid-cols-[1fr_auto] md:items-center md:p-6">
      <div>
        <p class="text-sm font-black uppercase text-white/60">Costs and risks</p>
        <h2 class="mt-2 text-2xl font-black tracking-normal md:text-3xl">Check the complete price before committing.</h2>
        <p class="mt-2 max-w-2xl text-sm font-bold leading-6 text-white/72">
          Add the item, domestic delivery, service charges, packing, international shipping, insurance, conversion, and possible tax or import fees. Promotions and route availability can change and are controlled by CSSBuy, not CSSFinds.
        </p>
      </div>
      <a class="button min-h-14 bg-[#ff4b0b] px-6 text-base font-black text-white hover:bg-[#e83f00]" href={cssbuySignupUrl} target="_blank" rel="sponsored noopener">
        Check Current CSSBuy Terms
      </a>
    </div>
  </section>

  <section class="shell mt-10" aria-labelledby="faq-heading">
    <div class="grid gap-5 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
      <div>
        <p class="text-sm font-black uppercase text-clay">FAQ</p>
        <h2 id="faq-heading" class="mt-2 text-2xl font-black tracking-normal text-ink md:text-3xl">
          CSSBuy Beginner Questions
        </h2>
        <p class="mt-3 text-sm font-bold leading-6 text-ink/58">
          Quick answers about QC photos, delivery estimates, shipping costs, and the limits of a product-research index.
        </p>
      </div>
      <div class="grid gap-3">
        {faqs.map((item) => (
          <details class="group rounded-lg border border-line bg-white p-4 shadow-soft">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-black text-ink">
              <span>{item.question}</span>
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-line text-xl leading-none text-ink/70 transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-sm font-bold leading-7 text-ink/65">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
