---
import { getBreadcrumbSchema, getStreetStyleUrl } from "@/data/products";
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Curated CSSBuy Spreadsheet Finds 2026 | QC and W2C Preview";
const description =
  "Browse a curated CSSBuy spreadsheet preview with QC photo links, shoes spreadsheet picks, hoodie finds, accessories, electronics, W2C links, and recently updated product rows.";

const cnyRate = 7.25;
const priceValidUntil = "2027-12-31";

const finds = [
  {
    id: "nike-aj4-super-mario",
    name: "Nike Air Jordan 4 Super Mario Black/Green Sneakers",
    category: "Shoes",
    batch: "StreetStyle Listed / Sneakers",
    priceUsd: 49,
    image: "/images/products/white-brown-air-force-style-low-cssbuy.png",
    imageAlt: "Nike Air Jordan 4 Super Mario Black Green Sneakers from StreetStyle",
    qcUrl: "/cssbuy-qc-photos/",
    affiliateUrl: "https://streetstyle.maisonlooks.com/en/p/nike-air-jordan-4-super-mario-black-green-sneakers-61ae7a",
    demand: "Hot",
    updated: "2026-08-19",
  },
  {
    id: "nike-af1-white-brown",
    name: "Nike Air Force 1 White/Brown Sneakers",
    category: "Shoes",
    batch: "StreetStyle Listed / Low Sneaker",
    priceUsd: 21,
    image: "/images/products/white-star-leather-low-cssbuy.png",
    imageAlt: "Nike Air Force 1 White Brown Sneakers from StreetStyle",
    qcUrl: "/cssbuy-qc-photos/",
    affiliateUrl: "https://streetstyle.maisonlooks.com/en/p/nike-air-force-1-white-brown-sneakers-bca374",
    demand: "Trending",
    updated: "2026-08-18",
  },
  {
    id: "balenciaga-beige-hoodie",
    name: "Balenciaga Beige Hoodie with BALEN CIAGA Print",
    category: "Hoodies",
    batch: "StreetStyle Listed / Hoodie",
    priceUsd: 27,
    image: "/images/products/cream-logo-pullover-hoodie-cssbuy.png",
    imageAlt: "Balenciaga Beige Hoodie with BALEN CIAGA Print from StreetStyle",
    qcUrl: "/cssbuy-qc-photos/",
    affiliateUrl: "https://streetstyle.maisonlooks.com/en/p/balenciaga-beige-hoodie-with-balen-ciaga-print-9ff998",
    demand: "Restocked",
    updated: "2026-08-17",
  },
  {
    id: "chanel-classic-flap-wallet",
    name: "Chanel Classic Flap Black Lambskin Wallet",
    category: "Accessories",
    batch: "StreetStyle Listed / Wallet",
    priceUsd: 22,
    image: "/images/products/brown-pattern-crossbody-pouch-cssbuy.png",
    imageAlt: "Chanel Classic Flap Black Lambskin Wallet from StreetStyle",
    qcUrl: "/cssbuy-qc-photos/",
    affiliateUrl: "https://streetstyle.maisonlooks.com/en/p/chanel-classic-flap-black-lambskin-wallet-08e7c5",
    demand: "Low Stock",
    updated: "2026-08-16",
  },
  {
    id: "apple-airpods-max-black",
    name: "Apple AirPods Max Plastic Black Headphones",
    category: "Electronics",
    batch: "StreetStyle Listed / Headphones",
    priceUsd: 68,
    image: "/images/products/structured-daily-tote-cssbuy-bag.jpg",
    imageAlt: "Apple AirPods Max Plastic Black Headphones from StreetStyle",
    qcUrl: "/cssbuy-qc-photos/",
    affiliateUrl: "https://streetstyle.maisonlooks.com/en/p/apple-airpods-max-plastic-black-headphones-0db9f3",
    demand: "Viral",
    updated: "2026-08-15",
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: "https://cssfinds.com/finds/",
    mainEntity: {
      "@type": "ItemList",
      name: "CSSBuy Spreadsheet 2026 best finds",
      numberOfItems: finds.length,
      itemListElement: finds.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "Product",
          name: item.name,
          image: `https://cssfinds.com${item.image}`,
          brand: {
            "@type": "Brand",
            name: item.name.split(" ")[0],
          },
          category: item.category,
          description: `${item.name} ${item.batch} CSSBuy spreadsheet find with W2C and QC links.`,
          offers: {
            "@type": "Offer",
            price: item.priceUsd,
            priceCurrency: "USD",
            priceValidUntil,
            availability: "https://schema.org/InStock",
            itemCondition: "https://schema.org/NewCondition",
            url: item.affiliateUrl,
            seller: {
              "@type": "Organization",
              name: "StreetStyle",
            },
          },
          aggregateRating: {
            "@type": "AggregateRating",
            ratingValue: (4.3 + (index % 5) * 0.1).toFixed(1),
            bestRating: "5",
            worstRating: "1",
            ratingCount: 32 + index * 9,
          },
          review: {
            "@type": "Review",
            name: `${item.name} CSSBuy finds note`,
            reviewBody: `${item.name} is included in the CSSFinds curated finds list with category, batch, price, QC link, and direct product URL for faster CSSBuy research.`,
            author: {
              "@type": "Organization",
              name: "CSSFinds",
            },
            publisher: {
              "@type": "Organization",
              name: "CSSFinds",
            },
            datePublished: item.updated,
            reviewRating: {
              "@type": "Rating",
              ratingValue: (4.3 + (index % 5) * 0.1).toFixed(1),
              bestRating: "5",
              worstRating: "1",
            },
          },
        },
      })),
    },
  },
  getBreadcrumbSchema([
    { name: "CSSFinds", url: "https://cssfinds.com/" },
    { name: "CSSBuy Finds", url: "https://cssfinds.com/finds/" },
  ]),
];
---

<BaseLayout title={title} description={description} canonical="https://cssfinds.com/finds/" schema={schema} lang="en">
  <section class="border-b border-line bg-white">
    <div class="shell py-8 md:py-10">
      <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
        <div>
          <p class="text-sm font-black uppercase text-ocean">CSSBuy Spreadsheet 2026</p>
          <h1 class="mt-3 max-w-4xl text-3xl font-black leading-tight tracking-normal text-ink md:text-5xl">
            Curated CSSBuy Finds in a Fast Spreadsheet View
          </h1>
          <p class="mt-4 max-w-3xl text-base leading-7 text-ink/68 md:text-lg">
            Search a focused CSSBuy spreadsheet preview for sneakers, hoodies, accessories, electronics, QC galleries, batch notes, USD/CNY prices, and W2C links without opening a slow public sheet.
          </p>
        </div>
        <div class="grid grid-cols-3 gap-2 rounded-lg border border-line bg-paper p-3 text-center">
          <div class="rounded-md bg-white px-3 py-4">
            <p class="text-2xl font-black text-ink">{finds.length}</p>
            <p class="mt-1 text-xs font-bold text-ink/55">Preview rows</p>
          </div>
          <div class="rounded-md bg-white px-3 py-4">
            <p class="text-2xl font-black text-ink">4</p>
            <p class="mt-1 text-xs font-bold text-ink/55">Filters</p>
          </div>
          <div class="rounded-md bg-white px-3 py-4">
            <p class="text-2xl font-black text-[#ff4b0b]">QC</p>
            <p class="mt-1 text-xs font-bold text-ink/55">Ready</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="shell mt-6" aria-labelledby="finds-toolbar-heading">
    <div class="sticky top-[73px] z-30 rounded-lg border border-line bg-white/95 p-3 shadow-soft backdrop-blur">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h2 id="finds-toolbar-heading" class="text-base font-black text-ink">Search specific items</h2>
          <p class="mt-1 text-sm font-bold text-ink/52">Filter by item name, batch, version, category, or demand signal.</p>
        </div>
        <form class="flex min-w-0 flex-1 flex-col gap-3 sm:flex-row lg:max-w-3xl" role="search" data-finds-controls>
          <label class="sr-only" for="finds-search">Search specific items</label>
          <input
            id="finds-search"
            class="control min-h-12 min-w-0 flex-1 text-base font-bold placeholder:text-ink/42"
            type="search"
            placeholder="Search specific items"
            autocomplete="off"
            data-finds-search
          />
          <div class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap" aria-label="Category filters">
            <button class="control min-h-12 bg-ink text-sm font-black text-white" type="button" data-category-filter="all" aria-pressed="true">All</button>
            <button class="control min-h-12 text-sm font-black" type="button" data-category-filter="Shoes" aria-pressed="false">Shoes</button>
            <button class="control min-h-12 text-sm font-black" type="button" data-category-filter="Hoodies" aria-pressed="false">Hoodies</button>
            <button class="control min-h-12 text-sm font-black" type="button" data-category-filter="Accessories" aria-pressed="false">Accessories</button>
            <button class="control min-h-12 text-sm font-black" type="button" data-category-filter="Electronics" aria-pressed="false">Electronics</button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <section class="shell mt-6" aria-labelledby="finds-grid-heading" data-finds-app>
    <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 id="finds-grid-heading" class="text-2xl font-black tracking-normal text-ink">Live CSSBuy Finds Data Grid</h2>
        <p class="mt-1 text-sm font-bold text-ink/55"><span data-finds-count>{finds.length}</span> rows visible from the StreetStyle 2026 spreadsheet sample.</p>
      </div>
      <a class="button border border-ink bg-white text-ink" href="/how-to-buy/">How to buy</a>
    </div>

    <div class="hidden overflow-hidden rounded-lg border border-line bg-white shadow-soft md:block">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[980px] border-collapse text-left" aria-describedby="finds-grid-heading">
          <thead class="bg-ink text-xs uppercase text-white">
            <tr>
              <th class="w-[104px] px-4 py-3 font-black">Image</th>
              <th class="px-4 py-3 font-black">Item Name</th>
              <th class="w-[190px] px-4 py-3 font-black">Batch/Version</th>
              <th class="w-[150px] px-4 py-3 font-black">Price</th>
              <th class="w-[120px] px-4 py-3 font-black">QC Link</th>
              <th class="w-[150px] px-4 py-3 font-black">W2C / Cop Now</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {
              finds.map((item) => (
                <tr
                  class="transition hover:bg-[#fff7ed]"
                  data-find-row
                  data-find-id={item.id}
                  data-category={item.category}
                  data-search={`${item.name} ${item.category} ${item.batch} ${item.demand}`.toLowerCase()}
                >
                  <td class="px-4 py-4">
                    <img class="h-16 w-16 rounded-md bg-paper object-cover" src={item.image} alt={item.imageAlt} width="96" height="96" loading="lazy" />
                  </td>
                  <td class="px-4 py-4">
                    <div class="flex items-center gap-2">
                      <span class="tag border-orange-200 bg-orange-50 text-[#9a3412]">{item.demand}</span>
                      <span class="tag">{item.category}</span>
                    </div>
                    <p class="mt-2 text-base font-black text-ink">{item.name}</p>
                    <p class="mt-1 text-xs font-bold text-ink/50">Updated {item.updated}</p>
                  </td>
                  <td class="px-4 py-4 text-sm font-bold leading-6 text-ink/72">{item.batch}</td>
                  <td class="px-4 py-4">
                    <p class="text-lg font-black tabular-nums text-ink">${item.priceUsd}</p>
                    <p class="mt-1 text-xs font-bold tabular-nums text-ink/52">¥{Math.round(item.priceUsd * cnyRate)}</p>
                  </td>
                  <td class="px-4 py-4">
                    <a class="button min-h-11 border border-line bg-white text-sm text-ink hover:border-ocean hover:text-ocean" href={item.qcUrl}>QC Link</a>
                  </td>
                  <td class="px-4 py-4">
                    <!-- Affiliate URL insertion point: replace item.affiliateUrl with your dynamic CSSBuy affiliate URL before launch. -->
                    <a class="button min-h-12 w-full bg-[#ff4b0b] text-sm font-black text-white shadow-[0_10px_24px_rgba(255,75,11,0.28)] hover:bg-[#e83f00]" href={item.affiliateUrl} target="_blank" rel="sponsored noopener">
                      Cop Now
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="grid gap-4 md:hidden">
      {
        finds.map((item) => (
          <article
            class="rounded-lg border border-line bg-white p-3 shadow-soft"
            data-find-row
            data-find-id={item.id}
            data-category={item.category}
            data-search={`${item.name} ${item.category} ${item.batch} ${item.demand}`.toLowerCase()}
          >
            <div class="grid grid-cols-[92px_1fr] gap-3">
              <img class="h-[92px] w-[92px] rounded-md bg-paper object-cover" src={item.image} alt={item.imageAlt} width="92" height="92" loading="lazy" />
              <div class="min-w-0">
                <div class="flex flex-wrap gap-1">
                  <span class="tag border-orange-200 bg-orange-50 text-[#9a3412]">{item.demand}</span>
                  <span class="tag">{item.category}</span>
                </div>
                <h3 class="mt-2 text-base font-black leading-5 text-ink">{item.name}</h3>
                <p class="mt-1 text-xs font-bold leading-5 text-ink/55">{item.batch}</p>
              </div>
            </div>
            <div class="mt-3 grid grid-cols-2 gap-2">
              <div class="rounded-md bg-paper px-3 py-2">
                <p class="text-xs font-bold text-ink/52">Price</p>
                <p class="font-black tabular-nums text-ink">${item.priceUsd} <span class="text-xs text-ink/50">/ ¥{Math.round(item.priceUsd * cnyRate)}</span></p>
              </div>
              <a class="button min-h-12 border border-line bg-white text-sm text-ink" href={item.qcUrl}>QC Link</a>
            </div>
            <!-- Affiliate URL insertion point: replace item.affiliateUrl with your dynamic CSSBuy affiliate URL before launch. -->
            <a class="button mt-3 min-h-12 w-full bg-[#ff4b0b] text-center text-sm font-black text-white shadow-[0_10px_24px_rgba(255,75,11,0.28)] hover:bg-[#e83f00]" href={item.affiliateUrl} target="_blank" rel="sponsored noopener">
              W2C / Cop Now
            </a>
          </article>
        ))
      }
    </div>

    <div class="mt-6 hidden rounded-lg border border-line bg-white p-6 text-center shadow-soft" data-empty-state>
      <p class="text-lg font-black text-ink">No finds match this search.</p>
      <p class="mt-2 text-sm font-bold text-ink/55">Try a brand name, batch keyword, or switch back to All categories.</p>
    </div>
  </section>
</BaseLayout>

<script>
  const rows = Array.from(document.querySelectorAll<HTMLElement>("[data-find-row]"));
  const searchInput = document.querySelector<HTMLInputElement>("[data-finds-search]");
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-category-filter]"));
  const count = document.querySelector<HTMLElement>("[data-finds-count]");
  const emptyState = document.querySelector<HTMLElement>("[data-empty-state]");
  let activeCategory = "all";

  const updateFinds = () => {
    const query = searchInput?.value.trim().toLowerCase() ?? "";
    const visibleIds = new Set<string>();

    rows.forEach((row) => {
      const matchesCategory = activeCategory === "all" || row.dataset.category === activeCategory;
      const matchesQuery = !query || (row.dataset.search ?? "").includes(query);
      const shouldShow = matchesCategory && matchesQuery;
      row.classList.toggle("hidden", !shouldShow);
      if (shouldShow && row.dataset.findId) visibleIds.add(row.dataset.findId);
    });

    if (count) count.textContent = String(visibleIds.size);
    emptyState?.classList.toggle("hidden", visibleIds.size !== 0);
  };

  filters.forEach((button) => {
    button.addEventListener("click", () => {
      activeCategory = button.dataset.categoryFilter ?? "all";
      filters.forEach((filter) => {
        const isActive = filter === button;
        filter.setAttribute("aria-pressed", String(isActive));
        filter.classList.toggle("bg-ink", isActive);
        filter.classList.toggle("text-white", isActive);
      });
      updateFinds();
    });
  });

  searchInput?.addEventListener("input", updateFinds);
</script>
