---
import CssbuyInfoSection from "@/components/CssbuyInfoSection.astro";
import FaqSection from "@/components/FaqSection.astro";
import ProductExplorer from "@/components/ProductExplorer.astro";
import { categories, getBreadcrumbSchema, products, promotionUrl, streetStyleSearchUrl } from "@/data/products";
import BaseLayout from "@/layouts/BaseLayout.astro";

const lang = "en";
const suggestedQueries = [
  "CSSBuy shoes spreadsheet",
  "CSSBuy hoodie finds",
  "CSSBuy T-shirts spreadsheet",
  "CSSBuy bags spreadsheet",
];
const title = "Source-Checked CSSBuy Product Catalog 2026 | CSSFinds";
const description =
  "Browse 42 source-checked CSSBuy listings with StreetStyle sources, recorded CNY prices, check times, direct buyer QC evidence, selection reasons, and risk notes.";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "CSSFinds",
    url: "https://cssfinds.com/",
  },
  getBreadcrumbSchema([{ name: "CSSFinds", url: "https://cssfinds.com/" }]),
];
---

<BaseLayout title={title} description={description} schema={schema} lang={lang}>
  <section
    class="relative overflow-hidden bg-ink bg-cover bg-center text-white"
    style="background-image: linear-gradient(90deg, rgba(17, 24, 39, 0.86) 0%, rgba(17, 24, 39, 0.64) 42%, rgba(17, 24, 39, 0.18) 100%), url('/images/hero/cssbuy-shipping-hero.png');"
  >
    <div class="shell py-12 md:py-16 lg:py-20">
      <div class="flex flex-wrap gap-2">
        <span class="tag border-ink bg-ink text-white">42 source-checked listings</span>
        <span class="tag border-white/35 bg-white/92 text-ink">Recorded CNY prices</span>
        <span class="tag border-white/35 bg-white/92 text-ink">Direct QC evidence</span>
      </div>
      <h1 class="mt-5 max-w-4xl text-4xl font-black leading-tight tracking-normal drop-shadow-sm md:text-5xl">
        42 Source-Checked Product Listings
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-7 text-white/86 md:text-lg">
        We reduced the catalog to 42 product pages that were opened and checked on StreetStyle. Every listing records the displayed CNY price, source-check time, buyer QC-photo count, an editorial selection reason, and category-specific risks. This is listing research, not product authentication.
      </p>
      <div class="mt-4 flex max-w-3xl flex-wrap items-center gap-2 text-sm font-bold text-white/78" aria-label="Suggested CSSBuy spreadsheet searches">
        <span class="text-white">Suggested searches:</span>
        {suggestedQueries.map((query) => <span class="rounded-full border border-white bg-white px-3 py-1 text-ink shadow-sm">{query}</span>)}
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <button class="button bg-white text-ink" type="button" data-scroll-target="product-catalog">Browse product catalog</button>
        <a class="button border border-white/40 bg-white/12 text-white hover:border-white" href={promotionUrl} rel="sponsored noopener" target="_blank">Visit StreetStyle</a>
      </div>
      <form
        class="mt-5 flex w-full max-w-4xl overflow-hidden rounded-lg border border-white/35 bg-white shadow-2xl shadow-ink/25"
        action={streetStyleSearchUrl}
        method="get"
        target="_blank"
        rel="noopener"
        role="search"
        aria-label="Search StreetStyle finds"
        data-streetstyle-search
      >
        <label class="sr-only" for="hero-streetstyle-search">Search products on StreetStyle</label>
        <input
          id="hero-streetstyle-search"
          class="min-h-14 min-w-0 flex-1 border-0 bg-white px-5 text-base font-bold text-ink outline-none placeholder:text-ink/45 focus:ring-0"
          type="search"
          name="q"
          placeholder="Search products on StreetStyle..."
          autocomplete="off"
          data-streetstyle-search-input
        />
        <button class="min-h-14 shrink-0 bg-[#ff4b0b] px-6 text-base font-black text-white transition hover:bg-[#e83f00] md:px-8" type="submit">
          Search on StreetStyle
        </button>
      </form>
    </div>
  </section>

  <div id="product-catalog">
    <ProductExplorer
      products={products}
      lang={lang}
      heading="42-listing evidence catalog"
      intro="Filter the editorial selection by category, brand, and maximum CNY price. Each card links to the source and the buyer QC-photo evidence we checked on StreetStyle."
      showSearch={false}
    />
  </div>
  <section class="shell mt-12">
    <div class="grid gap-4 rounded-lg border border-line bg-white p-5 md:grid-cols-[1.2fr_2fr] md:items-center">
      <div>
        <h2 class="text-xl font-black text-ink">CSSBuy spreadsheet categories</h2>
        <p class="mt-2 text-sm leading-6 text-ink/65">
          Filter the source-checked selection above, or open focused category pages for shoes, hoodies, T-shirts, bags, accessories, and pants.
        </p>
      </div>
      <div class="flex flex-wrap gap-2 text-sm font-bold">
        <button class="rounded-md border border-ink bg-ink px-3 py-2 text-white" type="button" data-scroll-target="product-catalog">Browse all products</button>
        {categories.map((category) => (
          <a class="rounded-md border border-line px-3 py-2 text-ink/75 hover:border-ink hover:text-ink" href={`/cssbuy-${category.slug}/`}>
            {category.title}
          </a>
        ))}
      </div>
    </div>
  </section>
  <FaqSection lang={lang} />
  <CssbuyInfoSection lang={lang} />
</BaseLayout>
